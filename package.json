{
  "name": "diagnosi-ia",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack && npm run notices:generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/third-party-notices.node-test.mjs && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node scripts/db/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "notices:generate": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "prebuild": "node scripts/third-party-notices.mjs --clean",
    "notices:audit:server": "node scripts/third-party-notices.mjs --server",
    "notices:check:server": "node scripts/third-party-notices.mjs --server --check"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.1.0",
    "mysql2": "^3.22.5",
    "next": "16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
